{
  "name": "stalcraft-dossier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STALZONE dossier: SQLite source of truth, HTTP API, MCP server and the static dossier page",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch apps/api/src/server.ts",
    "start": "node apps/api/dist/server.js",
    "mcp": "tsx apps/mcp/src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "export:json": "tsx scripts/export-json.ts",
    "golden": "tsx scripts/golden.ts",
    "sync": "tsx scripts/sync.ts",
    "sync:base": "tsx scripts/sync.ts base",
    "sync:wiki": "tsx scripts/sync.ts wiki",
    "sync:prices": "tsx scripts/sync.ts prices",
    "sync:profile": "tsx scripts/sync.ts profile",
    "build": "tsx scripts/build-web.ts",
    "build:server": "tsup",
    "build:all": "npm run build && npm run build:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/etag": "^6.0.1",
    "@fastify/static": "^8.1.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
