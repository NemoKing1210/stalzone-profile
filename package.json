{
  "name": "stalcraft-dossier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STALZONE dossier: Nuxt site and API over a SQLite source of truth, with an MCP server for the agent",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:cli": "tsup",
    "start": "node .output/server/index.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "mcp": "tsx packages/mcp/src/stdio.ts",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset.ts",
    "import:legacy": "tsx scripts/import-legacy.ts",
    "export:json": "tsx scripts/cli.ts export",
    "golden": "tsx scripts/golden.ts",
    "sync": "tsx scripts/cli.ts sync",
    "backup": "tsx scripts/cli.ts backup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "e2e": "playwright test",
    "typecheck": "npm run typecheck:node && nuxt typecheck",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "hash-password": "tsx scripts/cli.ts hash-password"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/ui": "^4.12.0",
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.6.4",
    "vue": "^3.5.13",
    "vue-router": "^5.5.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.51.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
