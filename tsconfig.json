{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@dossier/shared": ["packages/shared/src/index.ts"],
      "@dossier/shared/*": ["packages/shared/src/*"],
      "@dossier/core": ["packages/core/src/index.ts"],
      "@dossier/core/*": ["packages/core/src/*"],
      "@dossier/sources": ["packages/sources/src/index.ts"],
      "@dossier/sources/*": ["packages/sources/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "**/dist", "tests/e2e/**"]
}
