# Copy to .env; never commit the filled file.

# --- database ---
DB_PATH=./data/dossier.db

# --- access ---
# Either a scrypt hash (recommended) or a plain development password.
# Generate a hash: npm run hash-password
NUXT_PASSWORD_HASH=
NUXT_PASSWORD=
# At least 32 random characters; sessions do not survive a restart without it.
NUXT_SESSION_SECRET=
NUXT_LOGIN_RATE_MAX=5
NUXT_LOGIN_WINDOW_MS=60000

# --- MCP ---
# Empty disables the HTTP MCP endpoint (it answers 404).
NUXT_MCP_TOKEN=

# --- sources ---
REALM=ru
PROFILE_FILE=./db/seeds/profile.json
