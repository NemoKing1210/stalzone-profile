# Runtime database (relative to the app root unless absolute)
NUXT_DB_PATH=./data/dossier.db

# Realm used by imports and syncs
NUXT_REALM=ru

# Session cookie signing key. At least 32 characters; generate with `openssl rand -hex 32`.
NUXT_SESSION_SECRET=

# Password for the site. Prefer the scrypt hash; plain NUXT_PASSWORD is for local dev only.
NUXT_PASSWORD_HASH=
NUXT_PASSWORD=

# Bearer token for the HTTP MCP transport and agent access to /api/v1.
# Empty disables both HTTP MCP and bearer access.
NUXT_MCP_TOKEN=

# Public application name
NUXT_PUBLIC_APP_NAME=STALZONE Dossier

# Where downloaded snapshots and API caches are stored
SNAPSHOTS_DIR=./snapshots

# Legacy project used by `import` when db/seeds is not enough
LEGACY_ROOT=[redacted legacy source]

# Optional price source override
SCPMODEL_BASE_URL=
