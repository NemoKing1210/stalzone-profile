# Runtime database (relative to the repo root unless absolute)
DB_PATH=./data/dossier.db

# HTTP API
HOST=127.0.0.1
PORT=3000
# Token for POST /api/v1/admin/sync/:source. Empty = admin sync disabled.
ADMIN_TOKEN=
# Optional bearer token for the HTTP MCP transport. Empty = HTTP transport off.
MCP_TOKEN=
MCP_TRANSPORT=stdio

# Realm used by imports and syncs
REALM=ru

# Legacy project used by import:legacy when db/seeds is not enough
LEGACY_ROOT=[redacted legacy source]

# Where downloaded snapshots and API caches are stored
SNAPSHOTS_DIR=./snapshots

# Public base URL (used only for logs and docs)
PUBLIC_URL=http://localhost:3000
