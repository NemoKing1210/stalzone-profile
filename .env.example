# =============================================================================
#  STALZONE Profile — local environment template
# =============================================================================
#
#  Copy this file to `.env` and fill in the secrets:
#
#      cp .env.example .env
#
#  `.env` is read by `npm run dev`, `npm run build` and the CLI/scripts.
#  Variables already exported in the shell win over the file.
#  `.env` is gitignored: never commit it and never share it — it holds the
#  site password and the session secret.
#
#  Conventions:
#    - one KEY=value per line, no quotes, no spaces around "=";
#    - an empty value means "not configured" and the default applies;
#    - lines starting with "#" are comments.
#
#  Docker deployments do not read this file: see deploy/docker-compose.yml.
#  The reference table for every variable is in docs/CONFIGURATION.md.
#
# =============================================================================


# --- Access & sessions -------------------------------------------------------

# Site password. Set ONE of the next two variables.
#
# Recommended: the scrypt hash, never the plain password. Generate it with
#     npm run hash-password -- 'my-password'
# and paste the printed "scrypt$<salt>$<key>" string here:
NUXT_PASSWORD_HASH=

# Development shortcut: a plain password. Ignored while the hash above is set.
# example: NUXT_PASSWORD=dev
NUXT_PASSWORD=

# Signs the profile_session cookie (HMAC). At least 32 characters.
# Generate one with:
#     node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Empty = a new random secret on every start, so all sessions end on restart.
NUXT_SESSION_SECRET=

# Sign-in rate limit, counted per client address before the password is checked.
# Default: 5 attempts per 60000 ms (one minute).
# example: NUXT_LOGIN_RATE_MAX=10
NUXT_LOGIN_RATE_MAX=5
NUXT_LOGIN_WINDOW_MS=60000

# Trust the X-Forwarded-For header. Set 1 only behind a reverse proxy
# (Caddy/nginx) that overwrites it; otherwise clients can spoof the header
# and dodge the rate limit.
# example: NUXT_TRUST_PROXY=1
NUXT_TRUST_PROXY=


# --- Storage -----------------------------------------------------------------

# SQLite database — the single source of truth. In Docker: /data/profile.db
DB_PATH=./data/profile.db

# Downloaded item icons (*.png) and rendered admin icons (*.webp), served as
# /icons/<sha1>.<ext>. In Docker: /data/icons
ICONS_DIR=./public/icons

# Database copies created by `npm run backup`.
SNAPSHOTS_DIR=./snapshots


# --- Dev server --------------------------------------------------------------

# Address `npm run dev` binds to and prints in the console. Set the local domain
# to see the domain there instead of 127.0.0.1; it must resolve through the
# hosts file (add "127.0.0.1 stalzone-profile.local" to it).
# Defaults: DEV_HOST=127.0.0.1, DEV_PORT=80
# example: DEV_HOST=stalzone-profile.local
# DEV_HOST=127.0.0.1
# DEV_PORT=80


# --- Data sources ------------------------------------------------------------

# Region folder used by the EXBO catalog and the auction prices.
# Default: ru
REALM=ru


# --- Official STALZONE profile API (optional) --------------------------------

# Client-credentials pair issued for the STALZONE API. When BOTH are set the
# setup wizard and `npm run sync profile` fill public statistics (time in game,
# kills, shots, achievements) from the official API. Left empty, every counter
# is still editable by hand.
# One pair is enough locally: the dev server falls back to these plain names.
# Docker sets the NUXT_ pair (compose forwards it to both consumers).
# STALZONE_CLIENT_ID=
# STALZONE_CLIENT_SECRET=

# Endpoints; defaults are the public ones. Override only for a proxy or a mock.
# STALZONE_API_URL=https://eapi.stalzone.com
# STALZONE_TOKEN_URL=https://exbo.net/oauth/token


# --- Diagnostics -------------------------------------------------------------

# Lines written before the database is open (a failed migration, a missing
# directory). Runtime logging settings — level, retention, row cap, browser
# capture — live in the database and change in Settings -> Logging or through
# the API/MCP; they are not environment variables.
# LOG_BOOT_LEVEL: warn (default) | info | error | off
# LOG_BOOT_STDOUT=0 silences boot lines.
# LOG_BOOT_LEVEL=warn
# LOG_BOOT_STDOUT=1


# --- MCP ---------------------------------------------------------------------

# Bearer token for the HTTP MCP endpoint (/mcp). Empty = the endpoint is off
# and answers 404. Clients send "Authorization: Bearer <token>".
# Generate one with:
#     node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# example: NUXT_MCP_TOKEN=3f9a1c... (48 hex characters)
NUXT_MCP_TOKEN=

# Optional: make `npm run mcp` talk to a running server instead of the local
# database. The bearer token falls back to NUXT_MCP_TOKEN above.
# example: PROFILE_API_URL=https://stalzone.example.com
# PROFILE_API_URL=


# =============================================================================
#  Reference: docs/CONFIGURATION.md
#  If `.env` leaked, rotate NUXT_PASSWORD_HASH and NUXT_SESSION_SECRET.
# =============================================================================
